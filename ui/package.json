{
  "name": "ui",
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:client": "npm run dev --workspace=apps/client-ui",
    "dev:logistics": "npm run dev --workspace=apps/logistics-ui",
    "dev:courier": "npm run dev --workspace=apps/courier-ui",
    "generate-orders-api": "swagger-typescript-api generate -p ../orders/target/openapi.json -o ./packages/shared-core/api -n OrdersApiClient.ts --fetch",
    "generate-logistics-api": "swagger-typescript-api generate -p ../logistics/target/openapi.json -o ./packages/shared-core/api -n LogisticsApiClient.ts --fetch",
    "generate-courier-api": "swagger-typescript-api generate -p ../courier/target/openapi.json -o ./packages/shared-core/api -n CourierApiClient.ts --fetch",
    "generate-tracking-api": "swagger-typescript-api generate -p ../tracking/target/openapi.json -o ./packages/shared-core/api -n TrackingApiClient.ts --fetch"
  },
